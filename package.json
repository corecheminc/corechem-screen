{
  "name": "corechem-screen",
  "productName": "CoreChem Screen",
  "version": "0.1.0",
  "description": "CoreChem Hub office-screen app: shows the Hub's TV page full-screen and hosts Teams / Zoom / Meet meetings inside it, joined under the screen's name.",
  "main": "src/main.js",
  "private": true,
  "license": "UNLICENSED",
  "author": "CoreChem Inc.",
  "scripts": {
    "start": "electron . --hub=https://corecheminc-hub.vercel.app",
    "check": "node --check src/main.js && node --check src/preload-display.js && node --check src/preload-meeting.js",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.6.0"
  },
  "build": {
    "appId": "com.corecheminc.screen",
    "productName": "CoreChem Screen",
    "copyright": "CoreChem Inc.",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowElevation": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "CoreChemScreen-Setup.${ext}",
      "shortcutName": "CoreChem Screen"
    },
    "publish": [{ "provider": "github", "owner": "corecheminc", "repo": "corechem-screen", "releaseType": "release" }]
  }
}
